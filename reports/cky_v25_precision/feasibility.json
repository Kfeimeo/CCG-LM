  "important_findings": [
    "Original BF16 AMP Composer LayerNorm returns FP32, so internal semantic states were already FP32.",
    "FP32 IEEE policy disables AMP inside Composer from true FP32 semantic embedding inputs.",
    "FP16 policy explicitly stores states as FP16 after AMP LayerNorm FP32 output.",
    "Local potentials/leaf scores are BF16 under outer AMP; width>=2 CKY retained scores are FP32, but first leaf-pair addition occurs before float().",
    "TF32 is process-global for FP32 matmul; changes outside Composer cannot be excluded in joint cross-precision comparisons.",
    "Same-precision paired identity and fixed-DAG tracing separate Lazy effects from outer Transformer precision."
  ],
  "backend_api": "torch.backends.fp32_precision=ieee; torch.backends.cuda.matmul.fp32_precision=ieee|tf32; no legacy allow_tf32 setters",
  "composer_formula": "unchanged; diagnostics expose existing gate, residual and output tensors",
  "sources": [
    "https://docs.pytorch.org/docs/2.12/notes/numerical_accuracy.html",
    "https://docs.pytorch.org/docs/2.12/notes/amp_examples.html"
